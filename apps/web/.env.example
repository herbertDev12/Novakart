# Auth.js (next-auth v5)
AUTH_SECRET=
# AUTH_URL is auto-detected from the request in most deployments (Vercel, etc).
# Set it explicitly only if the auto-detected value is wrong for your environment.
# AUTH_URL=http://localhost:3000

# Backend API (apps/api)
API_URL=http://localhost:5157
# "mock" routes fetcher calls to local fixtures until the backend exposes real
# product/cart/order endpoints. Switch to "http" once apps/api implements them.
API_MODE=mock

# Public site origin, used for canonical URLs and absolute metadata links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
